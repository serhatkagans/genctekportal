node_modules
.next
.env
.env.local
coverage
*.log
veri

# MEDYA DEPOYA GİRMEZ (20 Ağustos 2026 kararı).
#
# public/wordpress ve public/temalar birlikte ~990 MB ve 4000'den fazla dosya:
# WordPress'ten aktarılmış haber görselleri, bilgi notu PDF'leri ve tema
# afişleri. Depoya konsaydı her klonlama gigabaytlık bir indirme olurdu ve
# GitHub 1 GB üzerindeki depolar için uyarı veriyor.
#
# DOSYALAR KAYBOLMUŞ DEĞİL: sunucuda /opt/genctekportal/public altında
# duruyorlar ve dağıtım onlara dokunmuyor. Depoyu başka bir makineye
# klonlayan kişi bu iki klasörü sunucudan ayrıca kopyalamalıdır.
public/wordpress
public/temalar

# İÇERİK DOSYALARI DEPODA DEĞİL (21 Ağustos 2026 kararı).
#
# data/*.json (haberler, koordinatörler, temalar, yönlendirmeler) yönetim
# panelinden YAZILIYOR. Depoda izlenirlerse iki sahipleri olur ve dağıtımdaki
# `git checkout -f`, sunucuda panelden yapılmış düzenlemeleri sessizce geri
# alır. Canlı içeriğin tek sahibi sunucudur.
#
# Başlangıç kopyaları data-ornek/ altında duruyor ve İZLENİYOR: yeni bir
# makinede `node scripts/veri-hazirla.mjs` eksik dosyaları oradan doldurur,
# var olanlara dokunmaz. Aynı desen yukarıdaki medya klasörlerinde de var.
/data

# TypeScript derleme önbelleği; makineye özel ve her derlemede değişir.
tsconfig.tsbuildinfo

# Ham görsel klasörü: siteye konacak fotoğrafların telefondan/kamera kartından
# gelen asıl hâlleri burada toplanıyor. Web'e giden ölçeklenmiş kopyalar
# public/medya altında; ham dosyalar (HEIC, 5-6 MB'lık JPG'ler) depoya girmez.
/resimler

# Ham görsel klasörü (ikinci yığın): sitede kullanılacak fotoğrafların kamera
# kartından gelen asıl hâlleri (~64 MB). Ölçeklenmiş kopyalar public/medya
# altında ve İZLENİYOR; ham dosyalar depoya girmez — tıpkı /resimler gibi.
/gorseller

# Zirve videoları: tek dosya 200 MB'ın üzerinde. public/wordpress ve
# public/temalar ile aynı karar — depoya girmez, sunucuda
# /opt/genctekportal/public/video altında durur, dağıtım dokunmaz.
public/video

# tmp/ karalama alanı: içine bakılan/indirilen dosyalar birikiyor ve sürüm
# betiği kirli ağaçta çalışmıyor. İzlenen tek şey tmp/pdfs.
/tmp/*
!/tmp/pdfs/
